# AFS-DBA-001 local configuration template.
# Copy to a file OUTSIDE the repository (or use your shell/secret manager) and
# set real values there. Never commit the populated file.
#
# The deployment wrapper reads these names from the process environment.
# Use strong, unique lab-only passwords; do not reuse personal passwords.

AFS_SQL_SERVER=localhost
AFS_SQL_DATABASE=master
AFS_DATA_ROOT=C:\AFS\Data
AFS_LOG_ROOT=C:\AFS\Log
AFS_BACKUP_ROOT=C:\AFS\Backups

# SQL logins created by sql-server/security/08_create_logins.sql
# Provide these only in the current process/session. The repository has no real values.
AFS_DBA_PASSWORD=
AFS_APP_PASSWORD=
AFS_DEVELOPER_PASSWORD=
AFS_REPORTING_PASSWORD=
AFS_AUDITOR_PASSWORD=
AFS_OPS_PASSWORD=

# Optional MySQL lab (never commit real values)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Optional Oracle lab
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=AFS_LAB
ORACLE_PASSWORD=
